# Copy to .env and fill in what you want to enable. Everything is optional:
# without these the app runs fully on-device with the built-in word list.

# --- Smarter (AI) analysis: used by the server in server/index.ts only, never sent to the browser.
# Leave unset if you've signed in with `ant auth login`; the SDK finds that profile itself.
ANTHROPIC_API_KEY=

# --- Accounts & sync (Supabase). Find these in your Supabase project under Settings → API.
# The anon/publishable key is safe in the browser; row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Natural-voice audio for guided practices (ElevenLabs). Only used on your computer by `npm run audio`;
# the app plays the MP3s it creates and never sees this key. Run `npm run audio -- --voices` to find a voice id.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
